{
  "name": "dayeon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev --prefix dayeon-web",
    "build": "npm run build --prefix dayeon-web",
    "start": "npm run start --prefix dayeon-web",
    "lint": "npm run lint --prefix dayeon-web",
    "install:web": "npm install --prefix dayeon-web",
    "setup": "npm install --prefix dayeon-web",
    "shop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start-shop.ps1",
    "shop:api": "npm run dev --prefix shop-api",
    "shop:web": "npm run dev --prefix shop-web",
    "shop:seed": "npm run seed --prefix shop-api",
    "shop:install": "npm install --prefix shop-api && npm install --prefix shop-web"
  }
}
