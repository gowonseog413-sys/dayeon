{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "shop-api",
      "codebase": "shop-api",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "environmentVariables": {
        "CORS_ORIGIN": "https://dayeon-shop.web.app,http://localhost:3600",
        "DB_PATH": "/tmp/dayeon-shop-db.json",
        "JWT_SECRET": "dayeon-firebase-prod-change-me"
      }
    }
  ],
  "hosting": [
    {
      "target": "main",
      "source": "dayeon-web",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "frameworksBackend": {
        "region": "asia-northeast3"
      }
    },
    {
      "target": "shop",
      "source": "shop-web",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "frameworksBackend": {
        "region": "asia-northeast3",
        "invoker": "public",
        "ingressSettings": "ALLOW_ALL"
      },
      "rewrites": [
        {
          "source": "/api/**",
          "function": {
            "functionId": "shopApi",
            "codebase": "shop-api",
            "region": "asia-northeast3"
          }
        }
      ]
    }
  ]
}
