PORT=3601
JWT_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:3600,https://dayeon-shop.web.app
# 로컬 개발 시 http://localhost:3600 (Google 로그인 콜백은 origin 파라미터로 자동 보정)
FRONTEND_URL=https://dayeon-shop.web.app

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# 승인된 리디렉션 URI (둘 다 Google Console에 등록):
#   https://dayeon-shop.web.app/api/auth/google/callback
#   http://localhost:3601/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://dayeon-shop.web.app/api/auth/google/callback
